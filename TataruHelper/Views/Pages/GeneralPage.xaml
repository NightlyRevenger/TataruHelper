<UserControl x:Class="FFXIVTataruHelper.Views.Pages.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:utils="clr-namespace:WpfXamlExtensions;assembly=WpfXamlExtensions"
             xmlns:ctl="clr-namespace:FFXIVTataruHelper.Views.Controls"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{DynamicResource SectionTitleStyle}"
                       Text="{DynamicResource SectionGeneral}" />
            <TextBlock Grid.Row="1"
                       Style="{DynamicResource CaptionTextStyle}"
                       Margin="0,0,0,16"
                       Text="{DynamicResource GeneralPageDescription}" />

            <ui:Card Grid.Row="2" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="16"
                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Style="{DynamicResource SectionSubtitleStyle}"
                                       Margin="0"
                                       Text="{DynamicResource DocLanguage}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                   Text="{DynamicResource LanguageGroupHint}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="220"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Shell.Languages}"
                              SelectedItem="{Binding Shell.SelectedLanguageOption, Mode=TwoWay}"
                              DisplayMemberPath="Title" />
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="3" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="DarkTheme24" FontSize="16"
                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Style="{DynamicResource SectionSubtitleStyle}"
                                       Margin="0"
                                       Text="{DynamicResource ThemeGroupTitle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                   Text="{DynamicResource ThemeGroupHint}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1"
                              Width="220"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Shell.ThemeOptions}"
                              DisplayMemberPath="Title"
                              SelectedItem="{Binding Shell.SelectedThemeOption, Mode=TwoWay}" />
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="4" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="16"
                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Style="{DynamicResource SectionSubtitleStyle}"
                                       Margin="0"
                                       Text="{DynamicResource UpdatesGroupTitle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                   Text="{DynamicResource UpdatesGroupHint}" />
                        <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                   Margin="0,6,0,0"
                                   Text="{Binding Shell.AppVersion, StringFormat=Version {0}}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               x:Name="CheckUpdatesButton"
                               Appearance="Primary"
                               Icon="{ui:SymbolIcon Symbol=ArrowSync24}"
                               Content="{DynamicResource CheckUpdatesText}"
                               Command="{Binding Shell.CheckUpdatesCommand}"
                               VerticalAlignment="Center" />
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="5" Padding="16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Style="{DynamicResource SectionSubtitleStyle}"
                                   Margin="0"
                                   Text="{DynamicResource ApplicationFlagsLabel}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource HideToTrayCB}" FontWeight="SemiBold" />
                            <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                       Text="{DynamicResource HideToTrayDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding Shell.IsHideSettingsToTray, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource RealtimeTranslationCB}" FontWeight="SemiBold" />
                            <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                       Text="{DynamicResource RealtimeTranslationDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding Shell.IsRealtimeTranslation, Mode=TwoWay}" />
                    </Grid>

                    <!-- Both this and the card below go when the game is
                         played in the language being read: there is nothing
                         to look up, so there is nothing to switch on and
                         nothing worth fetching. -->
                    <Grid Margin="0,12,0,0"
                          Visibility="{Binding Shell.IsReferenceTranslationUsable, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource LiteraryTranslationCB}" FontWeight="SemiBold" />
                            <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                       Text="{DynamicResource LiteraryTranslationDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding Shell.IsLiteraryTranslation, Mode=TwoWay}" />
                    </Grid>

                    <!-- Where those hand-made translations come from, and how to
                         fetch what the project has written since this release. -->
                    <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}"
                            Visibility="{Binding Shell.IsReferenceTranslationUsable, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                      <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource ReferenceIndexTitle}" FontWeight="SemiBold" />
                                <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                           Text="{DynamicResource ReferenceIndexHint}"
                                           TextWrapping="Wrap" />
                                <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                           Margin="0,6,0,0"
                                           Text="{Binding Shell.ReferenceIndexStatus}"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                            Visibility="{Binding Shell.HasReferenceIndexProgress, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                    <ui:ProgressRing Width="16" Height="16" Margin="0,0,8,0"
                                                     IsIndeterminate="True"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding Shell.IsReferenceIndexUpdating, Converter={utils:BooleanToVisibilityConverterCollapse}}" />
                                    <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                               VerticalAlignment="Center"
                                               Text="{Binding Shell.ReferenceIndexProgress}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ui:Button Appearance="Secondary"
                                           Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                                           Content="{DynamicResource ReferenceIndexUpdateButton}"
                                           Command="{Binding Shell.UpdateReferenceIndexCommand}"
                                           IsEnabled="{Binding Shell.CanUpdateReferenceIndex}"
                                           HorizontalAlignment="Stretch" />
                                <ui:Button Margin="0,6,0,0"
                                           Content="{DynamicResource ReferenceIndexCancelButton}"
                                           Command="{Binding Shell.CancelReferenceIndexUpdateCommand}"
                                           Visibility="{Binding Shell.IsReferenceIndexUpdating, Converter={utils:BooleanToVisibilityConverterCollapse}}"
                                           HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Whether the daily check may act on what it finds.
                             The checking is not optional; fetching a gigabyte
                             is. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource ReferenceIndexAutoInstallCB}" FontWeight="SemiBold" />
                                <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                           Text="{DynamicResource ReferenceIndexAutoInstallDescription}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                             IsChecked="{Binding Shell.IsReferenceIndexAutoInstall, Mode=TwoWay}" />
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource TranslateSpeakerNamesCB}" FontWeight="SemiBold" />
                            <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                       Text="{DynamicResource TranslateSpeakerNamesDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding Shell.IsSpeakerNameTranslated, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource TranslatePlayerNicknamesCB}" FontWeight="SemiBold" />
                            <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                       Text="{DynamicResource TranslatePlayerNicknamesDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding Shell.IsPlayerNicknameTranslated, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource MarkMachineTranslationCB}" FontWeight="SemiBold" />
                            <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                       Text="{DynamicResource MarkMachineTranslationDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding Shell.IsMachineTranslationMarked, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Row="6" Padding="16" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="ArrowReset24" FontSize="16"
                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Style="{DynamicResource SectionSubtitleStyle}"
                                       Margin="0"
                                       Text="{DynamicResource ResetSettingsTitle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                   Text="{DynamicResource ResetSettingsHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Icon="{ui:SymbolIcon Symbol=ArrowReset24}"
                               Content="{DynamicResource ResetSettingsButton}"
                               Command="{Binding Shell.ResetSettingsCommand}"
                               VerticalAlignment="Center" />
                </Grid>
            </ui:Card>

            <ui:Card Grid.Row="7" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="Translate24" FontSize="16"
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Style="{DynamicResource SectionSubtitleStyle}"
                                   Margin="0"
                                   Text="{DynamicResource TranslatorsLabel}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{DynamicResource CaptionTextStyle}"
                               Margin="0,0,0,10"
                               Text="{DynamicResource TranslatorsHint}" />

                    <!-- Free -->
                    <TextBlock Style="{DynamicResource CaptionTextStyle}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" Text="{DynamicResource FreeTranslatorsLabel}" />

                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                             IsChecked="{Binding Shell.TranslationCredentials.IsGoogleTranslateEnabled, Mode=TwoWay}" />
                            <TextBlock Text="Google Translate" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                             IsChecked="{Binding Shell.TranslationCredentials.IsYandexFreeEnabled, Mode=TwoWay}" />
                            <TextBlock Text="Yandex" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                             IsChecked="{Binding Shell.TranslationCredentials.IsPapagoEnabled, Mode=TwoWay}" />
                            <TextBlock Text="Papago" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Padding="12,10" Margin="0,0,0,14" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                             IsChecked="{Binding Shell.TranslationCredentials.IsDeepLEnabled, Mode=TwoWay}" />
                            <TextBlock Text="DeepL" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Paid -->
                    <TextBlock Style="{DynamicResource CaptionTextStyle}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" Text="{DynamicResource PaidTranslatorsLabel}" />

                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsAzureEnabled, Mode=TwoWay}" />
                                <TextBlock Text="Azure Translator" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowAzureSettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource AzureKeyLabel}" />
                                <ctl:SecretField
                                    Value="{Binding Shell.TranslationCredentials.AzureApiKey, UpdateSourceTrigger=LostFocus}"
                                    Masked="{Binding Shell.TranslationCredentials.AzureApiKeyMasked}"
                                    Margin="0,0,0,6" />
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource AzureRegionLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.AzureRegion, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsGoogleCloudEnabled, Mode=TwoWay}" />
                                <TextBlock Text="Google Cloud Translate" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowGoogleCloudSettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource GoogleCloudKeyLabel}" />
                                <ctl:SecretField
                                    Value="{Binding Shell.TranslationCredentials.GoogleCloudApiKey, UpdateSourceTrigger=LostFocus}"
                                    Masked="{Binding Shell.TranslationCredentials.GoogleCloudApiKeyMasked}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsDeepLApiEnabled, Mode=TwoWay}" />
                                <TextBlock Text="DeepL API" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowDeepLApiSettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource DeepLApiKeyLabel}" />
                                <ctl:SecretField
                                    Value="{Binding Shell.TranslationCredentials.DeepLApiKey, UpdateSourceTrigger=LostFocus}"
                                    Masked="{Binding Shell.TranslationCredentials.DeepLApiKeyMasked}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,10" Margin="0,0,0,14" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsYandexEnabled, Mode=TwoWay}" />
                                <TextBlock Text="Yandex Cloud" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowYandexSettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource YandexApiKeyLabel}" />
                                <ctl:SecretField
                                    Value="{Binding Shell.TranslationCredentials.YandexApiKey, UpdateSourceTrigger=LostFocus}"
                                    Masked="{Binding Shell.TranslationCredentials.YandexApiKeyMasked}"
                                    Margin="0,0,0,6" />
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource YandexFolderIdLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.YandexFolderId, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- AI -->
                    <TextBlock Style="{DynamicResource CaptionTextStyle}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" Text="{DynamicResource AITranslatorsLabel}" />

                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsOpenAIEnabled, Mode=TwoWay}" />
                                <TextBlock Text="OpenAI" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowOpenAISettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource OpenAIKeyLabel}" />
                                <ctl:SecretField
                                    Value="{Binding Shell.TranslationCredentials.OpenAIApiKey, UpdateSourceTrigger=LostFocus}"
                                    Masked="{Binding Shell.TranslationCredentials.OpenAIApiKeyMasked}"
                                    Margin="0,0,0,6" />
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource OpenAIModelLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.OpenAIModel, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsGeminiEnabled, Mode=TwoWay}" />
                                <TextBlock Text="Gemini" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowGeminiSettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource GeminiKeyLabel}" />
                                <ctl:SecretField
                                    Value="{Binding Shell.TranslationCredentials.GeminiApiKey, UpdateSourceTrigger=LostFocus}"
                                    Masked="{Binding Shell.TranslationCredentials.GeminiApiKeyMasked}"
                                    Margin="0,0,0,6" />
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource GeminiModelLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.GeminiModel, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsDeepSeekEnabled, Mode=TwoWay}" />
                                <TextBlock Text="DeepSeek" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowDeepSeekSettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource DeepSeekKeyLabel}" />
                                <ctl:SecretField
                                    Value="{Binding Shell.TranslationCredentials.DeepSeekApiKey, UpdateSourceTrigger=LostFocus}"
                                    Masked="{Binding Shell.TranslationCredentials.DeepSeekApiKeyMasked}"
                                    Margin="0,0,0,6" />
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource DeepSeekModelLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.DeepSeekModel, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsClaudeEnabled, Mode=TwoWay}" />
                                <TextBlock Text="Claude" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowClaudeSettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource ClaudeKeyLabel}" />
                                <ctl:SecretField
                                    Value="{Binding Shell.TranslationCredentials.ClaudeApiKey, UpdateSourceTrigger=LostFocus}"
                                    Masked="{Binding Shell.TranslationCredentials.ClaudeApiKeyMasked}"
                                    Margin="0,0,0,6" />
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource ClaudeModelLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.ClaudeModel, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" />
                                <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="{DynamicResource ClaudeCostHint}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsOpenRouterEnabled, Mode=TwoWay}" />
                                <TextBlock Text="OpenRouter" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowOpenRouterSettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="{DynamicResource OpenRouterHint}" />
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource OpenRouterKeyLabel}" />
                                <ctl:SecretField
                                    Value="{Binding Shell.TranslationCredentials.OpenRouterApiKey, UpdateSourceTrigger=LostFocus}"
                                    Masked="{Binding Shell.TranslationCredentials.OpenRouterApiKeyMasked}"
                                    Margin="0,0,0,6" />
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource OpenRouterModelLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.OpenRouterModel, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,10" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsYandexGptEnabled, Mode=TwoWay}" />
                                <TextBlock Text="YandexGPT" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowYandexGptSettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="{DynamicResource YandexGptUsesYandexHint}" />
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource YandexGptModelAliasLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.YandexGptModel, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Local models -->
                    <TextBlock Style="{DynamicResource CaptionTextStyle}"
                               FontWeight="SemiBold"
                               Margin="0,14,0,6" Text="{DynamicResource LocalModelsLabel}" />

                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsOllamaEnabled, Mode=TwoWay}" />
                                <TextBlock Text="Ollama" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowOllamaSettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource ServerAddressLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.OllamaEndpoint, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" Margin="0,0,0,6" />
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource OllamaModelLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.OllamaModel, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsLmStudioEnabled, Mode=TwoWay}" />
                                <TextBlock Text="LM Studio" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowLmStudioSettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource ServerAddressLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.LmStudioEndpoint, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" Margin="0,0,0,6" />
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource LmStudioModelLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.LmStudioModel, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="12,10" CornerRadius="6"
                            Background="{DynamicResource Brush.SurfaceSubtle}">
                        <StackPanel>
                            <DockPanel>
                                <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                                 IsChecked="{Binding Shell.TranslationCredentials.IsLibreTranslateEnabled, Mode=TwoWay}" />
                                <TextBlock Text="LibreTranslate" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding Shell.TranslationCredentials.ShowLibreTranslateSettings, Converter={utils:BooleanToVisibilityConverterCollapse}}">
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource LibreTranslateAddressLabel}" />
                                <TextBox
                                    Text="{Binding Shell.TranslationCredentials.LibreTranslateEndpoint, UpdateSourceTrigger=LostFocus}"
                                    KeyDown="CredentialTextBox_KeyDown" Margin="0,0,0,6" />
                                <Label Style="{DynamicResource BaseLabelStyle}"
                                       Content="{DynamicResource LibreTranslateKeyLabel}" />
                                <ctl:SecretField
                                    Value="{Binding Shell.TranslationCredentials.LibreTranslateApiKey, UpdateSourceTrigger=LostFocus}"
                                    Masked="{Binding Shell.TranslationCredentials.LibreTranslateApiKeyMasked}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:Card>

            <ui:Card Grid.Row="8" Padding="16" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Stethoscope24" FontSize="16"
                                           Margin="0,0,8,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock Style="{DynamicResource SectionSubtitleStyle}"
                                       Margin="0"
                                       Text="{DynamicResource DiagnosticsTitle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                   Text="{DynamicResource DiagnosticsHint}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{DynamicResource CaptionTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding Shell.DiagnosticsStatus}"
                                   Visibility="{Binding Shell.HasDiagnosticsStatus, Converter={utils:BooleanToVisibilityConverterCollapse}}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Icon="{ui:SymbolIcon Symbol=Copy24}"
                               Content="{DynamicResource DiagnosticsButton}"
                               Command="{Binding Shell.CopyDiagnosticsCommand}"
                               VerticalAlignment="Center" />
                </Grid>
            </ui:Card>
        </Grid>
    </ScrollViewer>
</UserControl>
