<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>FFXIVTataruHelper</RootNamespace>
    <AssemblyName>TataruHelper</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <!-- CA1416: the entire project targets net10.0-windows, so platform-availability warnings are noise. -->
    <NoWarn>$(NoWarn);1591;CA1416</NoWarn>
    <ApplicationIcon>Resources\app_icon2.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      Not marked CET-compatible. Since .NET 9 the executable is, by default,
      and Windows then runs it with a hardware shadow stack. A Windows 10 that
      has not had the update fixing its CET support - and a good many players
      keep updates off - cannot do that properly, and the runtime kills the
      process before a line of ours has run. From a reporter on 22H2 build
      19045.2728, with the runtime's own words captured off stderr:

        Fatal error.
        Your Windows doesn't fully support CET. Please install all available Windows updates.

      With Windows Error Reporting off, all they ever saw was an empty
      "Unknown Hard Error" box and exit code 0x80131506.

      What is given up is the shadow stack's guard against return-oriented
      exploits, in a process that reads a game's memory and talks to
      translation services. Everything else about the build is unchanged.
    -->
    <CetCompat>false</CetCompat>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NGettext" />
    <PackageReference Include="NHotkey.Wpf" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" />
    <PackageReference Include="Lumina" />
    <PackageReference Include="Sharlayan" />
    <PackageReference Include="Extended.Wpf.Toolkit" />
    <PackageReference Include="Velopack"/>
    <PackageReference Include="WPF-UI"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Translation\Translation.csproj" />
    <ProjectReference Include="..\Updater\Updater.csproj" />
    <ProjectReference Include="..\WpfXamlExtensions\WpfXamlExtensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Locale\**\*.mo">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Locale\**\*.po">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\ChatCodes.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Resources\MsgBlackList.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\IgnoreNickNameChatCodes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Nothing here carries the hand-made translations any more. They are
         hundreds of megabytes that the translation project adds to every
         week, so the application fetches them into the user's own folder
         instead: the update button on the General page, or

           TataruHelper.exe -build-reference-index

         (XML comments cannot carry a double dash; the switch takes either.) -->
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\tray_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Tataru_img.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\patreon_logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\heavy_heart.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\app_icon2.ico" />
    <Resource Include="Resources\DialogueFrame.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\NoticeFrame.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <Target Name="CrowdinPreBuild" BeforeTargets="BeforeBuild" Condition="'$(ConfigurationName)' == 'ReleaseDeploy' and '$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy RemoteSigned -file &quot;$(SolutionDir)\scripts\CrowdinScript\Crowdin_download.ps1&quot;" />
  </Target>

  <Target Name="VelopackPostBuild" AfterTargets="AfterBuild" Condition="'$(ConfigurationName)' == 'ReleaseDeploy' and '$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy RemoteSigned -file &quot;$(SolutionDir)\scripts\Velopack_release.ps1&quot;" />
  </Target>
</Project>
